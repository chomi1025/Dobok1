generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Message {
  id                Int       @id @default(autoincrement())
  content           String
  senderId          Int?
  receiverId        Int?
  postId            Int?
  companyName       String?
  jobRole           String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  deletedBySender   Boolean   @default(false)
  deletedByReceiver Boolean   @default(false)
  createdAt         DateTime  @default(now())
  post              Post?     @relation(fields: [postId], references: [id])
  receiver User? @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  sender   User? @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([receiverId, isRead])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuthStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  password          String
  createdAt         DateTime          @default(now())
  birthDate         DateTime
  name              String
  nickname          String?           @unique
  phone             String?           @unique
  username          String            @unique
  role              String            @default("USER")
  address           Json?
  ci                String?           @unique
  deletedAt         DateTime?
  status            UserStatus        @default(ACTIVE)
  lastLoginAt       DateTime?
  updatedAt         DateTime          @default(now()) @updatedAt


  businessStatus AuthStatus    @default(NONE)

  businessInfo   BusinessInfo?

  accounts          Account[]
  comments          Comment[]
  resourcePosts ResourcePost[]

  inquiries         Inquiry[]
  inquiryReplies    InquiryReply[]
  receivedMessages  Message[]         @relation("ReceivedMessages")
  sentMessages      Message[]         @relation("SentMessages")
  orders            Order[]
  posts             Post[]
  productQnas       ProductQna[]
  productQnaReplies ProductQnaReply[]
  reviews           Review[]
  reviewReplies     ReviewReply[]
  sessions          Session[]
  estimatePosts     EstimatePost[]
  viewLogs          ContactViewLog[] @relation("ViewerRelation")
  authoredLogs      ContactViewLog[] @relation("AuthorRelation")
  nicknameHistory   UserNicknameHistory[]
  deletedPosts      Post[]            @relation("DeletedPosts")
}

model BusinessInfo {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String   // 상호명
  businessNumber String   @unique // 사업자 번호
  representative String   // 대표자명
  taxEmail       String   // 세금계산서용 이메일
  paperUrl       String   // 이미지/PDF URL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserNicknameHistory {
  id          String   @id @default(cuid())
  userId      Int
  nickname    String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserWithdrawReason {
  id        Int      @id @default(autoincrement())
  userId    Int
  reason    String?
  detail    String?
  createdAt DateTime @default(now())
}



model ContactViewLog {
  id           Int      @id @default(autoincrement())

  viewerId     Int?
  authorId     Int?

  postId       Int
  createdAt    DateTime @default(now())

  viewer       User? @relation("ViewerRelation", fields: [viewerId], references: [id], onDelete: SetNull)
  author       User? @relation("AuthorRelation", fields: [authorId], references: [id], onDelete: SetNull)
}

model Verification {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parentId  Int?
  slug      String     @unique
  sortOrder Int?
  imageUrl  String?
  isVisible Boolean    @default(true)
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  discountType  PromotionType?
  discountValue Int?
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  categoryId     Int
  createdAt      DateTime        @default(now())
  description    String?
  images         String[]
  material       String          @default("")
  origin         String          @default("")
  thumbnail      String?
  isBest         Boolean         @default(false)
  isNew          Boolean         @default(false)
  isRecommended  Boolean         @default(false)
  announcement   Json?
  isCustomizable Boolean         @default(false)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  category       Category        @relation(fields: [categoryId], references: [id])
  options        ProductOption[]
  productQnas    ProductQna[]
  discountType   PromotionType?
  discountValue  Int?
  estimatePosts  EstimatePost[]
}

model ProductOption {
  id           Int           @id @default(autoincrement())
  productId    Int
  stock        Int
  optionName   String?
  optionName2  String?
  optionValue  String?
  optionValue2 String?
  status       ProductStatus @default(ONSALE)

  price        Int //원가
  discountType PromotionType? //퍼센트 혹은 가격
  discountValue Int? //할인값

  cartItems    CartItem[]
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}


enum PromotionType {
  PERCENTAGE
  FIXED
}



model CartItem {
  id              Int           @id @default(autoincrement())
  userId          Int
  productId       Int
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())
  productOptionId Int
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  option          ProductOption @relation(fields: [productOptionId], references: [id])

  @@unique([userId, productOptionId])
}

model Order {
  id             Int            @id @default(autoincrement())
  userId         Int?
  status         OrderStatus    @default(PENDING)
  orderNumber    String         @unique
  total          Int
  createdAt      DateTime       @default(now())
  customFileUrl  String?
  customRequest  String?
  address        String
  buyerEmail     String
  buyerName      String
  buyerPhone     String
  detailAddress  String
  postcode       String
  receiverName   String
  receiverPhone  String
  carrier        String?
  trackingNumber String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories      OrderHistory[]
  items          OrderItem[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  createdAt    DateTime @default(now())
  optionText   String?
  productImage String?
  productName  String
  totalPrice   Int
  unitPrice    Int

  originPrice  Int?
  salePrice    Int?
  discountRate Int?

  isCustom     Boolean  @default(false)
  claims       Claim[]
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviews      Review?
}

model OrderHistory {
  id        Int      @id @default(autoincrement())
  orderId   String
  content   String
  adminName String   @default("관리자")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [orderNumber])
}

model Claim {
  id          Int         @id @default(autoincrement())
  claimNumber String      @unique @default(uuid())
  claimType   ClaimType
  status      ClaimStatus @default(REQUESTED)
  requestedAt DateTime    @default(now())
  orderItemId Int?
  reason      String?
  processedAt DateTime?
  detail      String
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Review {
  id          Int          @id @default(autoincrement())
  orderItemId Int          @unique
  userId      Int?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating      Int
  content     String
  createdAt   DateTime     @default(now())
  images      String[]     @default([])
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  reply       ReviewReply?
}

model ReviewReply {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @unique

  content   String
  createdAt DateTime @default(now())
  adminId   Int?
  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id        Int             @id @default(autoincrement())
  content   String
  createdAt DateTime        @default(now())
  title     String?
  category  InquiryCategory @default(OTHER)
  status    InquiryStatus   @default(WAITING)
  isPrivate Boolean         @default(true)
  userId    Int?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies   InquiryReply?
  authorNameSnapshot  String?
}

model InquiryReply {
  id        Int      @id @default(autoincrement())
  inquiryId Int      @unique
  content   String
  createdAt DateTime @default(now())
  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model ProductQna {
  id        Int              @id @default(autoincrement())
  content   String
  isSecret  Boolean          @default(false)
  productId Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  reply     ProductQnaReply?
}

model ProductQnaReply {
  id           Int        @id @default(autoincrement())
  content      String
  productQnaId Int        @unique
  createdAt    DateTime   @default(now())
  adminId      Int?
  admin        User?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  productQna   ProductQna @relation(fields: [productQnaId], references: [id], onDelete: Cascade)
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isFixed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isFixed, createdAt(sort: Desc)])
}

model Faq {
  id        Int    @id @default(autoincrement())
  category  String
  question  String
  answer    String
  sortOrder Int    @default(0)
}

enum JobRole {
  TAEKWONDO
  JUDO
  HAPKIDO
  KENDO
  JUMP_ROPE
  GYM_PT
  SWIMMING
  ETC
}

model Post {
  id             Int              @id @default(autoincrement())
  type           PostType
  title          String
  content        String
  viewCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // 행사 정보
  eventCategory  EventCategory?
  eventDate      DateTime?
  city           String?
  district       String?
  eventVenue     String?
  applyMethod    String?

  // 구인구직
  jobRole        String?
  companyName    String?
  jobType        JobType?
  experience     ExperienceLevel? @default(IRRELEVANT)

  // 관계
  attachments    Attachment[]
  comments       Comment[]
  messages       Message[]
  authorId       Int?
  author         User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorNickname String?

  // 삭제
  deletedAt      DateTime?
  deletedBy      Int?
  deletedByUser  User? @relation("DeletedPosts", fields: [deletedBy], references: [id])
  deleteReason   DeleteReason?
  editHistories PostEditHistory[]

  @@index([type])
  @@index([city])
  @@index([eventCategory])
  @@index([eventDate])
}

model PostEditHistory {
  id        Int      @id @default(autoincrement())
  postId    Int
  title     String
  content   String
  editedAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
}

enum EventCategory {
  COMPETITION
  SEMINAR
  EVENT
  NOTICE
}

enum DeleteReason {
  USER
  ADMIN
  REPORTED
  SPAM
}

model Attachment {
  id        Int      @id @default(autoincrement())
  fileUrl   String
  fileName  String
  fileSize  Int
  fileType  String
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  postId    Int
  authorId Int?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ResourcePost {
  id           Int      @id @default(autoincrement())
  title        String
  content      String

  category     String   @default("DOCUMENT")

  videoUrl     String?
  externalUrl  String?

  createdAt    DateTime @default(now())

  authorId     Int
  author       User @relation(fields: [authorId], references: [id])

  attachments  ResourceAttachment[]
}

model ResourceAttachment {
  id        Int @id @default(autoincrement())
  fileName  String
  fileUrl   String
  publicId  String
  fileType String
  fileSize Int
  postId    Int
  post      ResourcePost @relation(fields: [postId], references: [id])
}

model EstimatePost {
  id             String   @id @default(cuid())
  title          String
  content        String   @db.Text
  writer         String
  phone          String
  email          String?
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  password       String?
  status         EstimateStatus @default(WAITING)
  isSecret       Boolean @default(true)
  adminReply     String? @db.Text
  repliedAt      DateTime?
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity       Int?
  size           String?
  printing       Boolean? @default(false)
  attachments    EstimateAttachment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  answeredAt     DateTime?
  history        EstimatePostHistory[]
  @@index([createdAt])
  @@index([status])

}

model EstimatePostHistory {
  id          String   @id @default(cuid())
  estimateId  String

  before      Json?
  after       Json?

  changedFields String[]

  userId      Int?

  isGuest     Boolean  @default(false)
  createdAt   DateTime @default(now())

  estimate    EstimatePost @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@index([createdAt])
}

enum EstimateStatus {
  WAITING
  PROCESSING
  DONE
}

model EstimateAttachment {
  id              String        @id @default(cuid())

  estimatePostId  String
  estimatePost    EstimatePost  @relation(fields: [estimatePostId], references: [id], onDelete: Cascade)

  url             String
  fileName        String

  createdAt       DateTime @default(now())
}

enum ProductStatus {
  ONSALE
  SOLDOUT
  HIDDEN
}

enum UserStatus {
  ACTIVE
  WITHDRAWN
  BANNED
}

enum Role {
  USER
  ADMIN
  BUSINESS
}

enum OrderStatus {
  PAYMENT_COMPLETE
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
  PENDING
}

enum ClaimType {
  CANCEL
  RETURN
  EXCHANGE
}

enum ClaimStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum InquiryCategory {
  PRODUCT
  DELIVERY
  ORDER
  RETURN
  OTHER
}

enum InquiryStatus {
  WAITING
  COMPLETED
}

enum PostType {
  JOB
  FREE
  EVENT
  RESOURCE
}

enum JobType {
  HIRING
  SEEKING
}

enum ExperienceLevel {
  NEWBIE
  JUNIOR
  MID_LEVEL
  SENIOR
  IRRELEVANT
}
