generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Message {
  id                Int       @id @default(autoincrement())
  content           String
  senderId          Int
  receiverId        Int
  postId            Int?
  companyName       String?
  jobRole           String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  deletedBySender   Boolean   @default(false)
  deletedByReceiver Boolean   @default(false)
  createdAt         DateTime  @default(now())
  post              Post?     @relation(fields: [postId], references: [id])
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender            User      @relation("SentMessages", fields: [senderId], references: [id])

  @@index([receiverId, isRead])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  password          String
  createdAt         DateTime          @default(now())
  birthDate         DateTime
  name              String
  phone             String?           @unique
  username          String            @unique
  role              String            @default("USER")
  address           Json?
  ci                String?           @unique
  deletedAt         DateTime?
  isDeleted         Boolean           @default(false)
  status            UserStatus        @default(ACTIVE)
  lastLoginAt       DateTime?
  updatedAt         DateTime          @default(now()) @updatedAt
  accounts          Account[]
  comments          Comment[]
  inquiries         Inquiry[]
  inquiryReplies    InquiryReply[]
  receivedMessages  Message[]         @relation("ReceivedMessages")
  sentMessages      Message[]         @relation("SentMessages")
  orders            Order[]
  posts             Post[]
  productQnas       ProductQna[]
  productQnaReplies ProductQnaReply[]
  reviews           Review[]
  reviewReplies     ReviewReply[]
  sessions          Session[]
}

model Verification {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parentId  Int?
  slug      String     @unique
  sortOrder Int?
  imageUrl  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  categoryId     Int
  createdAt      DateTime        @default(now())
  description    String?
  images         String[]
  material       String          @default("")
  origin         String          @default("")
  thumbnail      String?
  isBest         Boolean         @default(false)
  isNew          Boolean         @default(false)
  announcement   Json?
  isCustomizable Boolean         @default(false)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  category       Category        @relation(fields: [categoryId], references: [id])
  options        ProductOption[]
  productQnas    ProductQna[]
}

enum ProductStatus {
  ONSALE
  SOLDOUT
  HIDDEN
}

model ProductOption {
  id        Int        @id @default(autoincrement())
  productId Int
  price       Int

  optionName  String?
  optionValue String?
  optionName2  String?
  optionValue2 String?

  stock     Int
  sale      Int?
  status    ProductStatus    @default(ONSALE)
  cartItems CartItem[]
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CartItem {
  id              Int           @id @default(autoincrement())
  userId          Int
  productId       Int
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())
  productOptionId Int
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  option          ProductOption @relation(fields: [productOptionId], references: [id])

  @@unique([userId, productOptionId])
}

model Order {
  id             Int            @id @default(autoincrement())
  userId         Int?
  status         OrderStatus    @default(PENDING)
  orderNumber    String         @unique
  total          Int
  createdAt      DateTime       @default(now())
  customFileUrl  String?
  customRequest  String?
  address        String
  buyerEmail     String
  buyerName      String
  buyerPhone     String
  detailAddress  String
  postcode       String
  receiverName   String
  receiverPhone  String
  carrier        String?
  trackingNumber String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories      OrderHistory[]
  items          OrderItem[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  createdAt    DateTime @default(now())
  optionText   String?
  productImage String?
  productName  String
  totalPrice   Int
  unitPrice    Int
  isCustom     Boolean  @default(false)
  claims       Claim[]
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviews      Review?
}

model OrderHistory {
  id        Int      @id @default(autoincrement())
  orderId   String
  content   String
  adminName String   @default("관리자")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [orderNumber])
}

model Claim {
  id          Int         @id @default(autoincrement())
  claimNumber String      @unique @default(uuid())
  claimType   ClaimType
  status      ClaimStatus @default(REQUESTED)
  requestedAt DateTime    @default(now())
  orderItemId Int?
  reason      String?
  processedAt DateTime?
  detail      String
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Review {
  id          Int          @id @default(autoincrement())
  orderItemId Int          @unique
  userId      Int
  rating      Int
  content     String
  createdAt   DateTime     @default(now())
  images      String[]     @default([])
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  reply       ReviewReply?
}

model ReviewReply {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @unique
  adminId   Int
  content   String
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id])
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id        Int             @id @default(autoincrement())
  content   String
  createdAt DateTime        @default(now())
  userId    Int
  title     String?
  category  InquiryCategory @default(OTHER)
  status    InquiryStatus   @default(WAITING)
  isPrivate Boolean         @default(true)
  user      User            @relation(fields: [userId], references: [id])
  replies   InquiryReply?
}

model InquiryReply {
  id        Int      @id @default(autoincrement())
  inquiryId Int      @unique
  adminId   Int
  content   String
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id])
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model ProductQna {
  id        Int              @id @default(autoincrement())
  content   String
  isSecret  Boolean          @default(false)
  productId Int
  userId    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])
  reply     ProductQnaReply?
}

model ProductQnaReply {
  id           Int        @id @default(autoincrement())
  content      String
  productQnaId Int        @unique
  adminId      Int
  createdAt    DateTime   @default(now())
  admin        User       @relation(fields: [adminId], references: [id])
  productQna   ProductQna @relation(fields: [productQnaId], references: [id], onDelete: Cascade)
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isFixed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isFixed, createdAt(sort: Desc)])
}

model Faq {
  id        Int    @id @default(autoincrement())
  category  String
  question  String
  answer    String
  sortOrder Int    @default(0)
}

model Post {
  id          Int              @id @default(autoincrement())
  type        PostType
  title       String
  content     String
  authorId    Int
  viewCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  jobRole     String?
  companyName String?
  eventDate   DateTime?
  eventVenue  String?
  applyMethod String?
  jobType     JobType?
  experience  ExperienceLevel? @default(IRRELEVANT)
  city        String?
  district    String?
  attachments Attachment[]
  comments    Comment[]
  messages    Message[]
  author      User             @relation(fields: [authorId], references: [id])

  @@index([type])
  @@index([jobType])
  @@index([city])
  @@index([jobRole])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  fileUrl   String
  fileName  String
  fileSize  Int
  fileType  String
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  postId    Int
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  WITHDRAWN
  BANNED
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PAYMENT_COMPLETE
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
  PENDING
}

enum ClaimType {
  CANCEL
  RETURN
  EXCHANGE
}

enum ClaimStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum InquiryCategory {
  PRODUCT
  DELIVERY
  ORDER
  RETURN
  OTHER
}

enum InquiryStatus {
  WAITING
  COMPLETED
}

enum PostType {
  JOB
  FREE
  EVENT
  RESOURCE
}

enum JobType {
  HIRING
  SEEKING
}

enum ExperienceLevel {
  NEWBIE
  JUNIOR
  MID_LEVEL
  SENIOR
  IRRELEVANT
}
